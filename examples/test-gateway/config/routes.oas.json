{
  "openapi": "3.1.0",
  "info": {
    "title": "Test Gateway API",
    "description": "Test API for sc up verification",
    "version": "1.0.0"
  },
  "paths": {
    "/hello": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Hello endpoint",
        "description": "Returns a hello message",
        "operationId": "hello",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/hello)",
            "options": {}
          },
          "policies": {
            "inbound": []
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Health check",
        "description": "Returns health status",
        "operationId": "health",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/health)",
            "options": {}
          },
          "policies": {
            "inbound": []
          }
        },
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    }
  }
}
